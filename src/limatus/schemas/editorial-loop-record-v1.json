{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://papyrus.anth.us/schemas/editorial-loop-record-v1.json",
  "title": "EditorialLoopRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scan", "decisions", "options", "compareReport", "provenance"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scan": {
      "type": "object"
    },
    "decisions": {
      "type": "array"
    },
    "options": {
      "type": "object"
    },
    "compareReport": {
      "type": "object"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optionsModel", "skillPath", "judgePromptVersions"],
      "properties": {
        "optionsModel": {
          "type": "string"
        },
        "skillPath": {
          "type": "string"
        },
        "judgePromptVersions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "judgePromptVersionDefault": {
          "type": "string"
        }
      }
    }
  }
}
